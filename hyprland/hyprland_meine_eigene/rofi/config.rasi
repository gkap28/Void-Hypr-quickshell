* {
    font: "Figtree 13";
    g-spacing: 10px;
    g-margin: 0;
    g-padding: 8px;
    b-radius: 8px;
    w-padding: 12px;
    w-border: 2px solid;

    /* Nord Theme Farben */
    b-color: #2e3440ff;          /* Nord0: Dark Background */
    wbg-color: #2e3440dd;        /* Nord0 mit Transparenz */
    alt-color: #3b4252ff;        /* Nord1: Alternate Background */
    fg-color: #eceff4ff;         /* Nord6: Snow Storm Text */
    fgp-color: #4c566aff;        /* Nord3: Polar Night Gray (Placeholder) */
    hl-color: #88c0d0ff;         /* Nord8: Frost Blue (Selection Background) */
    hlt-color: #2e3440ff;        /* Nord0: Dark Text auf Selektion */
    w-border-color: #81a1c1ff;   /* Nord9: Frost Light Blue (Border) */
}

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
}

listview {
    columns: 1;
    lines: 9;                     /* Erhöht für die neue Fensterhöhe */
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
}

window {
    transparency: "real";
    width: 800px;                 /* Breite angepasst */
    height: 600px;                /* Höhe angepasst */
    border-radius: @b-radius;
    background-color: @wbg-color;
    border: @w-border;
    border-color: @w-border-color;
    padding: @w-padding;
}

prompt {
    text-color: @hl-color;
}

inputbar {
    children: ["prompt", "entry"];
    spacing: @g-spacing;
}

entry {
    placeholder: "Search Apps";
    text-color: @fg-color;
    placeholder-color: @fgp-color;
}

mainbox {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    children: ["inputbar", "listview", "message"];
}

element {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    border: 0px solid;
    border-radius: @b-radius;
    border-color: @b-color;
    background-color: transparent;
    text-color: @fg-color;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg-color;
}

element alternate.normal {
    background-color: @alt-color;
    text-color: @fg-color;
}

element selected.active {
    background-color: @hl-color;
    text-color: @hlt-color;
}

element selected.normal {
    background-color: @hl-color;
    text-color: @hlt-color;
}

message {
    background-color: #bf616aff; /* Nord11: Aurora Red */
    border: 0px solid;
}
