configuration {
    show-icons:                 false;
}

/* Globale Farbvariablen (Nordic Palette) */
* {
    background:     #2e3440ff; /* Nord0: Dark Background */
    background-alt: #3b4252ff; /* Nord1: Alternate Background */
    foreground:     #eceff4ff; /* Nord6: Snow Storm Text */
    accent:         #bf616aff; /* Nord11: Aurora Red für Fokus/Ausschalten */
    border-color:   #81a1c1ff; /* Nord9: Frost Light Blue für den Rahmen */
}

/* Hauptfenster im Zentrum */
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       400px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border:                      2px solid;
    border-radius:               12px;
    border-color:                @border-color;
    background-color:            @background;
    cursor:                      "default";
}

/* Container für das gesamte Layout */
mainbox {
    enabled:                     true;
    spacing:                     15px;
    padding:                     20px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/* Titel- und Suchleiste */
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     10px;
    border-radius:               8px;
    background-color: @background-alt;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "prompt" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    background-color:            transparent;
    text-color:                  #88c0d0ff; /* Nord8: Frost Blue für das Icon */
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
}

/* Die Liste der Einträge */
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       5;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     8px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/* Einzelnes Element in der Liste */
element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     10px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

/* Aktiv ausgewähltes Element */
element selected.normal {
    background-color:            @accent;
    text-color:                  @background; /* Invertiert Text für perfekte Lesbarkeit */
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
